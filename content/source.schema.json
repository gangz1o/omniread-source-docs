{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "云书阁规则书源 v1（发布配置）",
  "description": "公开作者配置的结构校验；同源校验、规则执行、媒体可用性由原生解析与联调验证。未知顶层字段不会自动获得引擎支持。",
  "oneOf": [
    {
      "$ref": "#/$defs/source"
    },
    {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "bookSourceName",
        "bookSourceUrl",
        "searchUrl",
        "ruleSearch",
        "ruleToc",
        "ruleContent"
      ],
      "properties": {
        "bookSourceName": {
          "type": "string",
          "minLength": 1
        },
        "bookSourceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^?#@]+$"
        },
        "bookSourceVersion": {
          "type": "string",
          "minLength": 1
        },
        "bookSourceGroup": {
          "type": "string",
          "minLength": 1
        },
        "bookSourceComment": {
          "type": "string",
          "minLength": 1
        },
        "charset": {
          "type": "string",
          "minLength": 1
        },
        "header": {
          "type": "string",
          "minLength": 1
        },
        "concurrentRate": {
          "type": "string",
          "minLength": 1
        },
        "searchUrl": {
          "type": "string",
          "minLength": 1
        },
        "exploreUrl": {
          "type": "string",
          "minLength": 1
        },
        "jsLib": {
          "type": "string",
          "minLength": 1
        },
        "loginUrl": {
          "type": "string",
          "minLength": 1
        },
        "loginUi": {
          "type": "string",
          "minLength": 1
        },
        "loginCheckJs": {
          "type": "string",
          "minLength": 1
        },
        "bookSourceType": {
          "type": "integer",
          "enum": [
            0,
            1,
            2
          ],
          "default": 0
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "enabledCookieJar": {
          "type": "boolean",
          "default": false
        },
        "ruleSearch": {
          "type": "object",
          "properties": {
            "bookList": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "author": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "intro": {
              "type": "string"
            },
            "coverUrl": {
              "type": "string"
            },
            "bookUrl": {
              "type": "string"
            },
            "lastChapter": {
              "type": "string"
            }
          },
          "required": [
            "bookList",
            "name",
            "bookUrl"
          ],
          "additionalProperties": false
        },
        "ruleExplore": {
          "type": "object",
          "properties": {
            "bookList": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "author": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "intro": {
              "type": "string"
            },
            "coverUrl": {
              "type": "string"
            },
            "bookUrl": {
              "type": "string"
            },
            "lastChapter": {
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "ruleBookInfo": {
          "type": "object",
          "properties": {
            "init": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "author": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "intro": {
              "type": "string"
            },
            "coverUrl": {
              "type": "string"
            },
            "tocUrl": {
              "type": "string"
            },
            "downloadUrls": {
              "type": "string"
            },
            "lastChapter": {
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "ruleToc": {
          "type": "object",
          "properties": {
            "chapterList": {
              "type": "string"
            },
            "chapterName": {
              "type": "string"
            },
            "chapterUrl": {
              "type": "string"
            },
            "nextTocUrl": {
              "type": "string"
            }
          },
          "required": [
            "chapterList",
            "chapterName",
            "chapterUrl"
          ],
          "additionalProperties": false
        },
        "ruleContent": {
          "type": "object",
          "properties": {
            "content": {
              "type": "string"
            },
            "nextContentUrl": {
              "type": "string"
            },
            "replaceRegex": {
              "type": "string"
            }
          },
          "required": [
            "content"
          ],
          "additionalProperties": false
        },
        "omnireadLogin": {
          "type": "object",
          "required": [
            "version",
            "type",
            "loginUrl",
            "sessionUrl"
          ],
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "integer",
              "const": 1
            },
            "type": {
              "enum": [
                "password",
                "apiKey"
              ]
            },
            "loginUrl": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^?#@]+$"
            },
            "sessionUrl": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^?#@]+$"
            }
          }
        },
        "omnireadMediaType": {
          "type": "string",
          "const": "video",
          "description": "云书阁短剧扩展，须与 bookSourceType 0 配合"
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "required": [
              "omnireadLogin"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "loginUrl"
                  ]
                },
                {
                  "required": [
                    "loginUi"
                  ]
                },
                {
                  "required": [
                    "loginCheckJs"
                  ]
                }
              ]
            },
            "properties": {
              "bookSourceUrl": {
                "pattern": "^https://"
              },
              "enabledCookieJar": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "omnireadMediaType"
            ]
          },
          "then": {
            "properties": {
              "bookSourceType": {
                "const": 0
              }
            }
          }
        }
      ]
    }
  }
}
